{
  "name": "slackfeedbot",
  "version": "1.2.9",
  "description": "Push RSS feed updates to Slack via GitHub Actions",
  "repository": {
    "type": "git",
    "url": "https://github.com/selfagency/slackfeedbot.git"
  },
  "license": "MIT",
  "author": "Daniel Sieradski <daniel@self.agency>",
  "type": "module",
  "main": "dist/index.cjs",
  "scripts": {
    "build": "esbuild src/action.ts --bundle --platform=node --target=node24 --outfile=dist/index.cjs",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "lint": "tsc --noEmit && ultracite check",
    "lint-staged": "lint-staged --allow-empty",
    "prepare": "husky",
    "start": "node dist/index.cjs",
    "test": "vitest run --passWithNoTests"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,json,jsonc}": [
      "npx ultracite fix"
    ]
  },
  "dependencies": {
    "@actions/core": "^1.9.1",
    "dayjs": "^1.11.0",
    "html-to-text": "^8.1.0",
    "linkedom": "^0.14.4",
    "node-fetch": "^3.2.10",
    "rss-to-json": "^2.1.1",
    "showdown": "^2.0.3",
    "striptags": "^3.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/html-to-text": "^8.1.0",
    "@types/node": "^24.19.4",
    "@types/showdown": "^1.9.4",
    "esbuild": "^0.28.2",
    "fallow": "^3.50.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "typescript": "~6.0.3",
    "ultracite": "^8.3.1",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=24"
  }
}
